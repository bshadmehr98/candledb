{
  "name": "candledb-client",
  "version": "0.1.0",
  "description": "Client SDK for the candledb document database",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshadmehr98/candledb.git",
    "directory": "sdk/js"
  },
  "homepage": "https://github.com/bshadmehr98/candledb/tree/main/sdk/js#readme",
  "bugs": "https://github.com/bshadmehr98/candledb/issues",
  "keywords": [
    "database",
    "realtime",
    "firestore",
    "document-database",
    "sse",
    "backend"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-timeout=120000 test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
